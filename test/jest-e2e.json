{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testMatch": ["<rootDir>/test/**/*.e2e-spec.ts"],
  "testEnvironment": "node",
  "moduleNameMapper": {
    "^\\.\\./\\.\\./generated/prisma/client$": "<rootDir>/test/mocks/prisma-client.ts"
  },
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "forceExit": true
}
