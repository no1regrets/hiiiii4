generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         BigInt      @id @default(autoincrement())
  telegramId BigInt   @unique @map("telegram_id")
  username   String?
  firstName  String?  @map("first_name")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  regRef     refSystem?   @relation(fields: [refId], references: [id]) // ссылка по которой зарег пользователь
  refId      BigInt?      @map("ref_id") // id ссылки по которой зарег пользователь
  is_admin   Boolean?       @default(false) @map("is_admin")

  @@map("users")
}

model refSystem {
  id        BigInt      @id // tgid пользователя, чья реф система
  User      User[]   
  refEarned Int      @default(0) @map("ref_earned")
  @@map("ref_systems")
}


