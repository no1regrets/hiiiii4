generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         Int      @id @default(autoincrement())
  telegramId Int   @unique @map("telegram_id")
  username   String?
  firstName  String?  @map("first_name")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  regRef     refSystem?   @relation(fields: [refId], references: [id])
  refId      Int?      @map("ref_id")

  @@map("users")
}

model refSystem {
  id        Int      @id @default(autoincrement())
  User      User[]   
  refEarned Int      @default(0) @map("ref_earned")
  @@map("ref_systems")
}


